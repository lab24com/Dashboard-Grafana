        "wrap": false,
        "contentPartials": [],
        "externalStyles": [],
        "helpers": "",
        "status": "",
        "afterRender": "/*\n * LAKA Soluciones Tecnológicas\n * Dashboard de recursos de servidores · Zabbix / Grafana\n * Autor: Willian Tola Laca | LAKA\n * Marca y presentación: LAKA Soluciones Tecnológicas\n */\nconst root=context.element;\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst name=context.grafana.replaceVariables('${host}');\nconst app=context.grafana.replaceVariables('${__appSubUrl}');\nconst base=app&&!app.includes('$')?app:'';\nconst range=context.grafana.timeRange;\nconst back=base+'/d/zbx-agents-resources-v3/windows-agentes-zabbix?from='+Number(range.from.valueOf())+'&to='+Number(range.to.valueOf());\nroot.innerHTML='<div class=\"zd-head\"><div><strong>'+esc(name)+'</strong><span class=\"laka-detail-brand\"><b>LAKA</b> Soluciones Tecnológicas</span><div class=\"zd-meta\">Consultando sistema operativo y versión del agente…</div></div><a href=\"'+esc(back)+'\">← Volver al principal</a></div>';\nconst token={};root.zdToken=token;\nconst uid=context.panelData.request?.targets?.map(t=>t.datasource?.uid).find(u=>u&&!u.includes('$'))||context.grafana.replaceVariables('${DS_ZABBIX}');\n(async()=>{\n const api=async(method,params)=>{const r=await fetch(base+'/api/datasources/uid/'+encodeURIComponent(uid)+'/resources/zabbix-api',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({method,params}),signal:AbortSignal.timeout(20000)});if(!r.ok)throw Error();const j=await r.json();if(j.error||!Array.isArray(j.result))throw Error();return j.result;};\n const hosts=await api('host.get',{output:['hostid','host','name'],filter:{name:[name]}});\n if(!hosts.length)throw Error();\n const items=await api('item.get',{hostids:hosts.map(h=>h.hostid),output:['key_','lastvalue','lastclock'],filter:{status:0,key_:['system.sw.os[name]','system.sw.os','system.uname','agent.version']}});\n const last=k=>items.find(i=>i.key_===k&&Number(i.lastclock)>0&&i.lastvalue)?.lastvalue;\n const os=last('system.sw.os[name]')||last('system.sw.os')||last('system.uname')||'SO sin valor disponible';\n const version=last('agent.version')||'Sin valor disponible';\n if(root.zdToken!==token)return;\n root.querySelector('.zd-meta').textContent=os+' · Agente Zabbix '+version;\n})().catch(()=>{if(root.zdToken===token)root.querySelector('.zd-meta').textContent='No se pudo consultar el sistema operativo y la versión del agente.';});",
        "styles": ".zd-head{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:10px 14px;color:#d8dee9;background:#20242b;border-left:4px solid #2dd4bf;border-radius:5px}.zd-head strong{font-size:21px}.zd-meta{font-size:13px;color:#b9c6d9;margin-top:5px;white-space:normal}.zd-head a{color:#6ae9d1;border:1px solid #454d59;border-radius:4px;padding:8px 12px;text-decoration:none;white-space:nowrap}\n/* Identidad visual: LAKA Soluciones Tecnológicas */\n.laka-detail-brand{display:inline-flex;align-items:center;gap:7px;margin-left:16px;color:#b9c6d9;font-size:11px}.laka-detail-brand b{font-size:15px;letter-spacing:2px;color:#2dd4bf}@media(max-width:700px){.laka-detail-brand{display:flex;margin-left:0;margin-top:6px}.zd-head{flex-wrap:wrap}}\n"
