      "options": {
        "renderMode": "data",
        "content": "<div class=\"zr-loading\">Cargando recursos de servidores…</div>",
        "defaultContent": "<div class=\"zr-loading\">No se recibieron datos de Zabbix.</div>",
        "editor": {
          "language": "html",
          "format": "none"
        },
        "editors": [
          "afterRender",
          "styles"
        ],
        "wrap": false,
        "contentPartials": [],
        "externalStyles": [],
        "helpers": "",
        "status": "",
        "afterRender": "/*\n * LAKA Soluciones Tecnológicas\n * Dashboard de recursos de servidores · Zabbix / Grafana\n * Autor: Willian Tola Laca | LAKA\n * Marca y presentación: LAKA Soluciones Tecnológicas\n */\nconst root=context.element;\nconst end=Number(context.grafana.timeRange.to.valueOf());\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst read=(f,i)=>f.values?.get?f.values.get(i):f.values?.[i];\nconst disks=new Map();\nfor(const frame of context.panelData?.series||[]) {\n const time=frame.fields?.find(f=>f.type==='time');\n for(const f of (frame.fields||[]).filter(f=>f.type==='number')) {\n  const scope=f.config?.custom?.scopedVars||{};\n  const key=f.labels?.item_key||scope.__zbx_item_key?.value||'';\n  const item=f.labels?.item||scope.__zbx_item?.value||f.config?.displayNameFromDS||frame.name||f.name;\n  const keyMatch=key.match(/^vfs\\.fs\\.(?:dependent\\.)?size\\[([^,]+),pused\\]$/);\n  const itemMatch=String(item).match(/FS \\[([^\\]]+)\\]/)||String(item).match(/\\(([A-Za-z]:)\\)/);\n  const volume=keyMatch?.[1]||itemMatch?.[1]||String(item).replace(/: Space.*$/,'');\n  let value=null,stamp=null;\n  for(let i=(f.values?.length||0)-1;i>=0;i--) {\n   const v=read(f,i);if(v===null||v===undefined||v===''||!Number.isFinite(Number(v)))continue;\n   value=Number(v);stamp=time?Number(read(time,i)):null;if(stamp&&stamp<1e11)stamp*=1000;break;\n  }\n  const fresh=value!==null&&value>=0&&value<=100&&stamp!==null&&stamp<=end&&end-stamp<=15*60000;\n  const previous=disks.get(volume);\n  if(!previous||Number(stamp)>Number(previous.stamp))disks.set(volume,{volume,item,value:fresh?value:null,stamp});\n }\n}\nroot.innerHTML='<div class=\"zd-disks\">'+[...disks.values()].sort((a,b)=>a.volume.localeCompare(b.volume)).map(d=>{\n const used=d.value,free=used===null?null:100-used;\n const color=used===null?'#6b7789':used>=90?'#ff6685':used>=75?'#ffc857':'#5794f2';\n const state=used===null?'Sin datos recientes':used>=90?'Crítico':used>=75?'Advertencia':'Normal';\n const background=used===null?'#353c46':'conic-gradient('+color+' 0% '+used+'%, #2dd4bf '+used+'% 100%)';\n return '<div class=\"zd-disk\" title=\"'+esc(d.item)+'\"><div class=\"zd-disk-title\">'+esc(d.volume)+'</div><div class=\"zd-donut\" role=\"img\" aria-label=\"'+esc(d.volume)+': '+(used===null?'sin datos':used.toFixed(1)+'% usado y '+free.toFixed(1)+'% libre')+'\" style=\"background:'+background+'\"><div class=\"zd-hole\"><b style=\"color:'+color+'\">'+(used===null?'—':used.toFixed(1)+'%')+'</b><span>usado</span></div></div><div class=\"zd-disk-status\" style=\"color:'+color+'\">'+state+'</div><div class=\"zd-disk-legend\"><span><i style=\"background:'+color+'\"></i>Usado '+(used===null?'—':used.toFixed(1)+'%')+'</span><span><i style=\"background:#2dd4bf\"></i>Libre '+(free===null?'—':free.toFixed(1)+'%')+'</span></div></div>';\n}).join('')+'</div>';\nif(!disks.size)root.innerHTML='<div class=\"zd-empty\">No se recibieron datos de los discos para este servidor y rango.</div>';\n",
        "styles": ".zd-disks{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;padding:6px;color:#d8dee9}.zd-disk{background:#20242b;border:1px solid #353c46;border-radius:6px;padding:12px;text-align:center}.zd-disk-title{font-size:15px;font-weight:600;margin-bottom:10px;overflow-wrap:anywhere}.zd-donut{width:130px;height:130px;margin:0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center}.zd-hole{width:96px;height:96px;border-radius:50%;background:#20242b;display:flex;flex-direction:column;align-items:center;justify-content:center}.zd-hole b{font-size:24px}.zd-hole span{font-size:11px;color:#a7b4c7;margin-top:3px}.zd-disk-status{font-size:11px;font-weight:600;margin:8px 0}.zd-disk-legend{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;font-size:11px}.zd-disk-legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px}.zd-empty{padding:20px;color:#a7b4c7}"
      }
    }
